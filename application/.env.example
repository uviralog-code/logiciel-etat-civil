# =====================================================================
# Configuration de l'application — copier ce fichier en « .env.local »
# et remplacer les valeurs (Supabase › Project Settings › API).
# =====================================================================

# Adresse du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé publique (« anon ») : peut être vue par le navigateur, les règles
# d'accès de la base protègent les données.
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique

# Clé de service : SECRÈTE. Uniquement sur le serveur, jamais dans le
# navigateur ni dans un dépôt de code. Sert à créer les comptes des agents.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-de-service

# Domaine des adresses internes des agents (ils ne le voient jamais)
NEXT_PUBLIC_DOMAINE_COMPTES=agents.etatcivil-uvira.local

# Adresse publique du logiciel, imprimée dans le QR code des reçus (fichier 39).
# Facultatif : sans ce réglage, l'adresse par laquelle la page est ouverte est utilisée.
# ADRESSE_PUBLIQUE=https://etatcivil.exemple.org
